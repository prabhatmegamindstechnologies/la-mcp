# Copy to .env (git-ignored). Never commit .env.

# ---- Local development ----
# sample = in-memory sample data (default) | cms = the CMS as one bot user (below)
LA_DATA=sample
CMS_API_URL=http://localhost:8787/la-studio/api
# Bot mode only: a CMS Editor user created for local testing.
CMS_EMAIL=
# Put the password in double quotes: an unquoted # starts a comment and cuts the password short.
CMS_PASSWORD=""
PORT=3000

# ---- OAuth mode (what runs on Vercel) ----
# Setting MCP_PUBLIC_URL turns on per-person sign-in. Everyone signs in with their own CMS account, so on a public
# URL CMS_EMAIL / CMS_PASSWORD must not be set. For a local try-out use MCP_PUBLIC_URL=http://localhost:3000.
# MCP_PUBLIC_URL=https://la-mcp.vercel.app
# At least 32 random characters. Changing it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# MCP_TOKEN_SECRET=
